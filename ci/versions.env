# Single source of truth for every pinned version in this repository.
#
# Bumping mpv: change MPV_REF and, if the new mpv release ships newer
# dependencies, bump the affected *_VER variables in the same commit.
#
# Every build script and every workflow sources this file. Do not duplicate
# version numbers anywhere else.
#
# All versions are the latest stable tags that existed on or before the
# mpv v0.41.0 release (2025-12-21), so a rebuild reproduces the same
# binary instead of drifting to upstream git HEAD.

# --- mpv itself -----------------------------------------------------------
MPV_REF=v0.41.0

# --- shared by all three platforms ----------------------------------------
FFMPEG_VER=n8.0.1
DAV1D_VER=1.5.2
LIBPLACEBO_VER=v7.351.0
LIBASS_VER=0.17.4
LCMS2_VER=lcms2.17
FREETYPE_VER=2.14.1
# Git tag name of the same release on gitlab.freedesktop.org (freetype moved
# to gitlab; no release tarballs are published there, so the build clones it).
FREETYPE_TAG=VER-2-14-1
FRIBIDI_VER=1.0.16
HARFBUZZ_VER=12.2.0

# --- linux only (fontconfig is the Linux font provider for libass) --------
FONTCONFIG_VER=2.16.2
EXPAT_VER=R_2_7_3

# --- windows only (no system zlib/iconv on MinGW) -------------------------
ICONV_VER=1.18
ZLIB_VER=1.3.1